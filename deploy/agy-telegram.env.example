TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_ALLOWED_USER_IDS=replace-with-numeric-user-id
TELEGRAM_PRIVATE_ONLY=1
AGY_BIN=/usr/local/bin/agy
AGY_WORKSPACE=/srv/agy-workspaces/default
AGY_MODE=plan
AGY_SANDBOX=1
# Keep sandbox enforced for Telegram users unless this is deliberately enabled.
# AGY_ALLOW_SANDBOX_DISABLE=0
AGY_EFFORT=high
AGY_AGENT=
# Keep disabled. If enabled, the flag still requires an explicit Telegram confirmation.
# AGY_ALLOW_DANGEROUSLY_SKIP_PERMISSIONS=0
# Optional comma-separated runtime model allowlist. Defaults to all known models.
# AGY_ALLOWED_MODELS=gemini-3.6-flash-high,gemini-3.1-pro-high,claude-sonnet-4-6
AGY_TIMEOUT_MS=1800000
AGY_MAX_OUTPUT_BYTES=20000000
MAX_QUEUE_SIZE=8
STATE_FILE=/var/lib/agy-telegram/state.json
TEMP_DIR=/var/lib/agy-telegram/tmp
