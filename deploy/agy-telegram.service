[Unit]
Description=AGY Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/hermes-workspace/antigravity-cli-telegram-bot
EnvironmentFile=/etc/agy-telegram.env
Environment=HOME=/root
ExecStart=/usr/bin/node /opt/hermes-workspace/antigravity-cli-telegram-bot/dist/cli.js
Restart=always
RestartSec=5
TimeoutStopSec=30

# Keep AGY and the bot from consuming the whole VPS.
CPUQuota=100%
MemoryMax=1536M
TasksMax=512

# Full-control mode: AGY must be able to write the workspace and use its
# configured tools without systemd filesystem restrictions.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
